#include<stdio.h>
#include<dirent.h>
#include<stdlib.h>
int main()
{
    char buff[100];
    DIR *dirp;
    struct dirent *dptr;
    printf("Enter the directory name:");
    scanf("%s", buff);
    if((dirp = opendir(buff)) == NULL)
    {
        printf("Given directory does not exist.");
        exit(1);
    }
    while((dptr = readdir(dirp)) != NULL)
    {
        printf("%s", dptr->d_name);
    }
    closedir(dirp);
    return 0;
}
