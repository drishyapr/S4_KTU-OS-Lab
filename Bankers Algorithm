    }
    if(r<n)
    {
        printf("Not safe");
    }
    else
    {
        printf("Safe sequence:");
        for(int i=0;i<n-1;i++)
        {
            printf("%d - >",safe[i]);
        }
        printf("%d",safe[n-1]);
    }
}
