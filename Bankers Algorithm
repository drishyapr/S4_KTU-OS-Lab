#include<stdio.h>
#include<stdlib.h>

int n,m,max[10][20],allocation[10][20],need[10][20],available[20],req[20];
int safe[10],finish[10];

void resourceReqAlgo(int r)
{
    for(int i=0;i<m;i++)
    {
        if((req[i]>need[r][i]) && (req[i]>available[i]))
        {
            printf("\nError\n\n");
            exit(0);
        }
    }
    for(int i=0;i<m;i++)
    {
        available[i]-=req[i];
        allocation[r][i]+=req[i];
        need[r][i]-=req[i];
    }
}

void safetyAlgo()
{
    int i,j,k=0,work[20];
    for(i=0;i<m;i++)
    {
        work[i]=available[i];
    }
    for(i=0;i<n;i++)
    {
        finish[i]=0;
    }
    for(i=0;i<n;i++)
    {
        for(j=k;(j+1)%n!=k;j=(j+1)%n)
        {
            if(!finish[i])
            {
                int a;
                for(a=0;a<m;a++)
                {
                    if(need[j][a]>work[a])
                    {   
                        break;
                    }
                }
                if(a<m)
                {
                    continue;
                }
                k=j;
                safe[i]=j;
                finish[j]=1;
                for(a=0;a,m;a++)
                {
                    work[a]+=allocation[j][a];
                }
                break;
            }
        }
    }
}

