    {
        printf("P%d",i);
        for(int j=0;j<m;j++)
        {
            scanf("%d",allocation[i][j]);
            need[i][j]=max[i][j]-allocation[i][j];
        }
    }
    printf("\nResource available:\n");
    for(int i=0;i<m;i++)
    {
        scanf("%d",available[i]);
    }
    printf("Has any process requested? [1/0]:");
    scanf("%d",&r);
    if(r)
    {
        printf("Requesting process no:");
        scanf("%d",&r);
        printf("Request:");
        for(int i=0;i<m;i++)
        {
            scanf("%d",req[i]);
        }
        resourceReqAlgo(r);
    }
    safetyAlgo();
    for(r=0;r<n;r++)
